       Flow benutzen soll. Genau dafür ist das Paket getrennt — wer den Flow nicht will,
       importiert es nicht und wird nie gefragt. -->
  <connectionreferences>
    <connectionreference connectionreferencelogicalname="ayonto_sharedcommondataserviceforapps_mention">
      <connectionreferencedisplayname>Microsoft Dataverse - Ayonto Mention</connectionreferencedisplayname>
      <connectorid>/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps</connectorid>
      <iscustomizable>1</iscustomizable>
      <promptingbehavior>0</promptingbehavior>
