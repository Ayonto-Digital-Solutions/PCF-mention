{
	"name": "pcf-group-detail-list",
	"version": "2.0.0",
	"description": "Power Apps component framework dataset control that renders a Dataverse view as a groupable, sortable list.",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "pcf-scripts build",
		"clean": "pcf-scripts clean",
		"lint": "pcf-scripts lint && eslint . --max-warnings 0",
		"lint:fix": "pcf-scripts lint fix && eslint . --fix --max-warnings 0",
		"rebuild": "pcf-scripts rebuild",
		"refreshTypes": "pcf-scripts refreshTypes",
		"start": "pcf-scripts start",
		"start:watch": "pcf-scripts start watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fluentui/react-components": "9.46.2",
		"react": "^16.14.0",
		"react-dom": "^16.14.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@microsoft/eslint-plugin-power-apps": "^0.2.51",
		"@testing-library/react": "^12.1.5",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^20.19.0",
		"@types/powerapps-component-framework": "^1.3.18",
		"@types/react": "^16.14.62",
		"@types/react-dom": "^16.9.24",
		"eslint": "^9.17.0",
		"eslint-plugin-promise": "^7.1.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"globals": "^15.15.0",
		"happy-dom": "^15.11.7",
		"pcf-scripts": "^1",
		"pcf-start": "^1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.44.0",
		"vitest": "^3.2.4"
	},
	"overrides": {
		"@types/react": "^16.14.62",
		"@types/react-dom": "^16.9.24",
		"react": "^16.14.0",
		"react-dom": "^16.14.0"
	},
	"engines": {
		"node": ">=20"
	}
}
