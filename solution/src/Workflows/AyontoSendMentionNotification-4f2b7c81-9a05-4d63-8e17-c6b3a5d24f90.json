{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "ayonto_sharedcommondataserviceforapps_mention"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Ayonto Mention Environment Url (ayonto_MentionEnvironmentUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ayonto_MentionEnvironmentUrl"
          }
        },
        "Ayonto Mention App Id (ayonto_MentionAppId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ayonto_MentionAppId"
          }
        },
        "Ayonto Mention Sender User (ayonto_MentionSenderUser)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ayonto_MentionSenderUser"
          }
        }
      },
      "triggers": {
        "Wenn_eine_Erwaehnung_angelegt_wird": {
          "type": "OpenApiConnectionWebhook",
          "metadata": {
            "operationMetadataId": "0b0f9f6c-2c4e-4a8f-9d07-5f6a1b2c3d40"
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "ayonto_mention",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "ayonto_deliverystatus eq 'New'"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Umgebungsadresse": {
          "type": "Compose",
          "runAfter": {
            "Datensatz_lesen": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5a5ec291-7193-4fd4-c25c-0ebf6a7b8c95"
          },
          "inputs": "@if(empty(parameters('Ayonto Mention Environment Url (ayonto_MentionEnvironmentUrl)')), concat('https://', uriHost(outputs('Datensatz_lesen')?['body/@odata.id'])), if(endsWith(parameters('Ayonto Mention Environment Url (ayonto_MentionEnvironmentUrl)'), '/'), substring(parameters('Ayonto Mention Environment Url (ayonto_MentionEnvironmentUrl)'), 0, sub(length(parameters('Ayonto Mention Environment Url (ayonto_MentionEnvironmentUrl)')), 1)), parameters('Ayonto Mention Environment Url (ayonto_MentionEnvironmentUrl)')))"
        },
        "Datensatzlink": {
          "type": "Compose",
          "runAfter": {
            "Umgebungsadresse": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "6b6fd3a2-82a4-40e5-d36d-1fa07b8c9da6"
          },
          "inputs": "@if(not(empty(triggerOutputs()?['body/ayonto_recordurl'])), triggerOutputs()?['body/ayonto_recordurl'], if(or(empty(outputs('Umgebungsadresse')), or(empty(triggerOutputs()?['body/ayonto_recordtable']), empty(triggerOutputs()?['body/ayonto_recordid']))), '', concat(outputs('Umgebungsadresse'), '/main.aspx?', if(empty(parameters('Ayonto Mention App Id (ayonto_MentionAppId)')), '', concat('appid=', parameters('Ayonto Mention App Id (ayonto_MentionAppId)'), '&')), 'pagetype=entityrecord&etn=', triggerOutputs()?['body/ayonto_recordtable'], '&id=', triggerOutputs()?['body/ayonto_recordid'])))"
        },
        "Datensatz_lesen": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "7c70e4b3-93b5-41f6-e47e-2ab18c9daeb7"
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem"
            },
            "parameters": {
              "entityName": "ayonto_mentions",
              "recordId": "@triggerOutputs()?['body/ayonto_mentionid']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Kanal": {
          "type": "Switch",
          "runAfter": {
            "Datensatzlink": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8d81f5c4-a4c6-4207-f58f-3bc18d9eafc8"
          },
          "expression": "@if(empty(triggerOutputs()?['body/ayonto_channel']), 'Email', triggerOutputs()?['body/ayonto_channel'])",
          "cases": {
            "E_Mail": {
              "case": "Email",
              "actions": {
                "Versand": {
                  "type": "Scope",
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "1c1a8e5d-3d5f-4b90-8e18-6a7b2c3d4e51"
                  },
                  "actions": {
                    "Absender_bestimmen": {
                      "type": "Compose",
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "a1a0b6e6-c6e8-4429-b7ab-5de3a0cb1eba"
                      },
                      "inputs": "@if(empty(parameters('Ayonto Mention Sender User (ayonto_MentionSenderUser)')), triggerOutputs()?['body/ayonto_mentionedbyid'], parameters('Ayonto Mention Sender User (ayonto_MentionSenderUser)'))"
                    },
                    "E_Mail_anlegen": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Absender_bestimmen": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "b2b1c7f7-d7f9-453a-c8bc-6ef4b1dc2fcb"
                      },
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord"
                        },
                        "parameters": {
                          "entityName": "emails",
                          "item/subject": "@coalesce(triggerOutputs()?['body/ayonto_subject'], 'Sie wurden erwähnt')",
                          "item/description": "@concat('<p>', coalesce(triggerOutputs()?['body/ayonto_message'], ''), '</p>', if(empty(triggerOutputs()?['body/ayonto_recordname']), '', concat('<p>Datensatz: ', triggerOutputs()?['body/ayonto_recordname'], '</p>')), if(empty(outputs('Datensatzlink')), '', concat('<p><a href=\"', outputs('Datensatzlink'), '\">', if(empty(triggerOutputs()?['body/ayonto_linktext']), 'Datensatz öffnen', triggerOutputs()?['body/ayonto_linktext']), '</a></p>')))",
                          "item/email_activity_parties": [
                            {
                              "partyid_systemuser@@odata.bind": "@concat('/systemusers(', outputs('Absender_bestimmen'), ')')",
                              "participationtypemask": 1
                            },
                            {
                              "partyid_systemuser@@odata.bind": "@concat('/systemusers(', triggerOutputs()?['body/ayonto_userid'], ')')",
                              "participationtypemask": 2
                            }
                          ]
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "E_Mail_senden": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "E_Mail_anlegen": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "c3c2d808-e80a-464b-d9cd-7fa5c2ed30dc"
                      },
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "PerformBoundAction"
                        },
                        "parameters": {
                          "entityName": "emails",
                          "recordId": "@outputs('E_Mail_anlegen')?['body/activityid']",
                          "actionName": "SendEmail",
                          "item/IssueSend": true
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  }
                },
                "Als_gesendet_vermerken": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Versand": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "3e3ca07f-5f71-4db2-a03a-8c9d4e5f6a73"
                  },
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord"
                    },
                    "parameters": {
                      "entityName": "ayonto_mentions",
                      "recordId": "@triggerOutputs()?['body/ayonto_mentionid']",
                      "item/ayonto_deliverystatus": "Sent"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Fehler_ermitteln": {
                  "type": "Query",
                  "runAfter": {
                    "Versand": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "d4d3e919-f91b-475c-eade-8ab6d3fe41ed"
                  },
                  "inputs": {
                    "from": "@result('Versand')",
                    "where": "@not(equals(item()?['status'], 'Succeeded'))"
                  }
                },
                "Als_fehlgeschlagen_vermerken": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Fehler_ermitteln": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "4f4db180-6082-4ec3-b14b-9dae5f6a7b84"
                  },
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord"
                    },
                    "parameters": {
                      "entityName": "ayonto_mentions",
                      "recordId": "@triggerOutputs()?['body/ayonto_mentionid']",
                      "item/ayonto_deliverystatus": "Failed",
                      "item/ayonto_deliverydetail": "@substring(string(first(body('Fehler_ermitteln'))?['error']), 0, min(480, length(string(first(body('Fehler_ermitteln'))?['error']))))"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Kanal_ohne_Zweig": {
                "type": "OpenApiConnection",
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "9e92a6d5-b5d7-4318-a69a-4cd29eafb0d9"
                },
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord"
                  },
                  "parameters": {
                    "entityName": "ayonto_mentions",
                    "recordId": "@triggerOutputs()?['body/ayonto_mentionid']",
                    "item/ayonto_deliverystatus": "Failed",
                    "item/ayonto_deliverydetail": "@concat('Für den Kanal ', triggerOutputs()?['body/ayonto_channel'], ' hat dieser Flow keinen Zweig. Zweig im Schalter Kanal ergänzen.')"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
